# OpenAI-compatible endpoint. We use OpenRouter (the event's OpenAI credits are
# Codex-only, not API). Copy to .env and fill in a real key. Never commit .env.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-v1-replace-me
OPENAI_MODEL=openai/gpt-4o-mini

# Model notes (measured):
#   openai/gpt-4o-mini          ~5s, correct plans  <- default, needs credits
#   openai/gpt-4o               ~4s, correct plans, ~10x the cost
#   nex-agi/nex-n2.5-pro:free   ~10s, correct plans, no credits needed (fallback)
# Develop with --mock-llm and spend credit on demo runs.

# Run fully offline with the mock planner: mjpython -m robot_agent.app.main --mock-llm
