# OpenAI-compatible endpoint. We use OpenRouter (the event's OpenAI credits are
# Codex-only, not API). Copy to .env and fill in a real key. Never commit .env.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-v1-replace-me
OPENAI_MODEL=nex-agi/nex-n2.5-pro:free

# Model notes (measured in Phase 0):
#   nex-agi/nex-n2.5-pro:free   ~10s, reliable multi-step plans  <- default, no credits needed
#   nex-agi/nex-n2.5-mini:free  ~3s, sometimes emits invalid plans (validator catches them)
#   openai/gpt-4o-mini          ~2s, reliable -- requires OpenRouter credits
# Free models are rate limited. Develop with --mock-llm, spend the quota on demo runs.

# Run fully offline with the mock planner: mjpython -m robot_agent.app.main --mock-llm
